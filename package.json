{
  "name": "vk-desktop",
  "version": "1.2.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/main/index.js",
  "description": "VK Desktop",
  "author": "yamixdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/yamixdev/vk-desktop.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "electron:ensure": "install-electron",
    "lint": "eslint .",
    "test": "node --test",
    "verify:extension": "node scripts/update-vk-next-integrity.mjs --check",
    "verify:fuses": "electron-fuses read --app \"dist/win-unpacked/VK Desktop.exe\"",
    "update:extension-integrity": "node scripts/update-vk-next-integrity.mjs --write",
    "check": "npm run lint && npm test && npm run verify:extension",
    "benchmark": "npm run electron:ensure && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/benchmark.ps1",
    "build:dir": "npm run electron:ensure && npm run check && electron-builder --win --x64 --dir --publish never && npm run verify:fuses",
    "build": "npm run electron:ensure && npm run check && electron-builder --win --x64 --publish never && npm run verify:fuses",
    "publish": "npm run electron:ensure && npm run check && electron-builder --win --x64 --publish always"
  },
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@xhayper/discord-rpc": "1.3.4",
    "builder-util-runtime": "9.7.0",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "semver": "7.8.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "eslint": "10.7.0",
    "globals": "17.7.0"
  },
  "build": {
    "appId": "com.yamixdev.vkdesktop",
    "productName": "VK Desktop",
    "asar": true,
    "asarUnpack": [
      "extensions/**/*",
      "assets/**/*"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "directories": {
      "output": "dist"
    },
    "artifactName": "VK-Desktop-Setup-${version}.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*",
      "extensions/**/*",
      "!**/*.map"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yamixdev",
        "repo": "vk-desktop"
      }
    ]
  }
}
